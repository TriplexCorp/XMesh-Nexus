# Use ./install.sh to generate unique secrets and create a mode-600 .env file.
POSTGRES_PASSWORD=replace-with-random-64-char-hex-secret
APP_DB_PASSWORD=replace-with-random-64-char-hex-secret
REDIS_PASSWORD=replace-with-random-64-char-hex-secret
DB_MAX_CONNECTIONS=20
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-random-64-char-hex-secret
COOKIE_SECURE=true
# Generate once: openssl rand -hex 32. Never change while 2FA is enabled.
TOTP_ENCRYPTION_KEY=replace-with-persistent-64-char-hex-secret
APP_BIND=127.0.0.1
APP_PORT=8080

# Auto-generated by install.sh; only this path serves the dashboard/login UI.
DASHBOARD_PATH=/dashboard/replace-with-random-48-character-hex-slug

