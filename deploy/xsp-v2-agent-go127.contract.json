{
  "schema": "xsp2-agent-go127-integration-v2",
  "productionActivation": false,
  "strictPqDefault": "off",
  "verifiedNodeSource": {
    "repository": "TriplexCorp/XMesh-Node",
    "revision": "5e8ee562915a570eb49ed46d59d723f233f3cc68"
  },
  "productionRouter": {
    "role": "edge-router-data-plane-adjacent",
    "modulePath": "github.com/TriplexCorp/XMesh-Node",
    "moduleDirectory": ".",
    "goVersion": "1.23",
    "dockerfile": "Dockerfile",
    "controlReporterInManagedDeployment": false,
    "mustRemainUnchangedByThisGate": true
  },
  "signedControlAgent": {
    "role": "fixed-control-lifecycle-orchestrator",
    "implementation": "deploy/node-control-agent.sh",
    "updater": "deploy/update-node-control-agent.sh",
    "fixedAction": "update_agent",
    "systemdUpdater": "xmesh-node-agent-upgrade.service",
    "migrationGate": "XSP_V2_P0D_AGENT_MIGRATION=staging-only",
    "releaseIdentity": [
      "version",
      "sourceRevision",
      "artifactSha256"
    ]
  },
  "agentIntegrationModule": {
    "role": "production-capable-agent-integration-boundary",
    "modulePath": "github.com/TriplexCorp/XMesh-Node/agent/xspv2",
    "moduleDirectory": "agent/xspv2",
    "goVersion": "1.27.3",
    "stateRoot": "/var/lib/xmesh-agent/xsp-v2",
    "installedByDefault": false,
    "productionActivated": false,
    "mayReplaceProductionRouter": false,
    "mayCreateParallelCommandQueue": false,
    "securityPrimitiveModule": "security/xspv2/poc-go",
    "durableSecurityState": {
      "cutoverJournalDirectory": "cutover",
      "keyStateDirectory": "keys",
      "nodeRequestVault": "keys/node-request.vault",
      "nodeRequestMasterKey": "keys/node-request.master",
      "prepareMayCreateOrRegenerateIdentity": false,
      "appliedRotationAttestation": "keyring.AttestAppliedRotation",
      "persistedEpochFloorRequired": true,
      "preparedCandidateRetentionRequired": true,
      "previousIdentityRetentionRequired": true,
      "packageRollbackMayLowerSecurityFloor": false,
      "corruptOrStaleState": "fail-closed"
    }
  },
  "go127SecurityRuntime": {
    "role": "reused-strict-xsp-v2-security-primitives",
    "modulePath": "github.com/TriplexCorp/XMesh-Node/security/xspv2/poc-go",
    "moduleDirectory": "security/xspv2/poc-go",
    "goVersion": "1.27.3",
    "reusePackages": [
      "envelope",
      "keyring",
      "tlsprobe",
      "cutover"
    ],
    "integrationModel": "dependency-of-agent-integration-module",
    "remoteActionAuthority": "signedControlAgent",
    "inboundNetworkListener": false,
    "mayReplaceProductionRouter": false,
    "mayCreateParallelCommandQueue": false
  },
  "authenticatedAuthority": {
    "directConnectField": "Address",
    "authenticatedServerNameField": "ServerName",
    "tlsSniFromServerName": true,
    "certificateHostnameFromServerName": true,
    "httpAuthorityFromServerName": true,
    "proxyAllowed": false,
    "redirectAllowed": false,
    "alternateAuthorityAllowed": false
  },
  "migrationRules": {
    "legacyUnboundUpdateRemainsCompatible": true,
    "boundMigrationRequiresExactReleaseIdentity": true,
    "missingSecurityRuntime": "fail-closed",
    "mixedVersionMigratedOperation": "fail-closed",
    "missingOrInvalidReceipt": "fail-closed",
    "transportFailure": "fail-closed",
    "automaticFallback": false,
    "forbiddenFallbacks": [
      "XMESH1",
      "Ed25519-only",
      "X25519-only",
      "TLS1.2",
      "insecure-certificate-verification"
    ]
  },
  "packagingBoundary": {
    "sourceRevisionMustEqualApprovedManifest": true,
    "artifactSha256MustEqualApprovedManifest": true,
    "callerSelectedExecutableLocation": false,
    "callerSelectedDownloadUrl": false,
    "lastKnownGoodRequiredBeforeApply": true,
    "stagedDownloadVerifyApplyRollbackComplete": true,
    "packageIdentitySeparatedFromSecurityState": true
  }
}
